# Supabase — Project Settings → API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret key (Project Settings → API keys → Secret). Used only by the
# auth rate limiter (public.auth_rate_limit_hit); without it the limit is in memory.
# Never expose it to the browser: no NEXT_PUBLIC_ prefix.
# BLVS-56: with it the live bus also relays every event to the other server
# instances over Supabase Realtime (broadcast «blvs-live», HMAC-signed).
SUPABASE_SECRET_KEY=sb_secret_xxx
# Turns that relay off (one instance only, e.g. local load tests).
# LIVE_RELAY=off

# Vercel Cron: shared secret of /api/cron/* (Vercel sends it as a Bearer token).
# The deadline job closes expired registrations with SUPABASE_SECRET_KEY.
CRON_SECRET=

# Server clock time zone (the helper in src/lib/time always uses Europe/Rome anyway)
TZ=Europe/Rome

# Staging/production only: redirect HTTP → HTTPS (308) and send HSTS
# ENFORCE_HTTPS=true

# Email: in sviluppo e CI vanno solo a Mailpit (http://127.0.0.1:54324 con
# `supabase start`). Le invia la Edge Function `send-emails`, i cui segreti di
# produzione si impostano con `supabase secrets set` (vedi README).
MAILPIT_URL=http://127.0.0.1:54324

# BLVS-18: admin inactivity before the session closes, in seconds
# (default 1800 = 30 min; values under 180 are ignored).
# ADMIN_SESSION_IDLE_SECONDS=1800
